---
import '@fontsource-variable/inter'
import '@fontsource-variable/jetbrains-mono'
import '../styles/site.css'
import { DESCRIPTION, PROVIDERS, RELEASES_URL, REPOSITORY_URL, TAGLINE } from '../data/site'

const rows = [
  {
    title: 'Review every change before it happens',
    text: 'Edits show a diff and commands wait for your answer. Each chat has its own mode: read only, ask first, accept edits or full access. Subagents follow the same rules.',
    image: 'chat',
    alt: 'A chat where the agent asks for approval before editing a file'
  },
  {
    title: 'Use any model you already pay for',
    text: 'Model lists come live from each provider, with context size and price. Connect a pay per token key or a coding plan from Z.ai, MiniMax, Kimi or Alibaba.',
    image: 'models',
    alt: 'The model picker with search, favorites and prices'
  },
  {
    title: 'Run prompts on a schedule',
    text: 'Set a daily review or a weekly report. Every run keeps its transcript, and you choose what happens to runs missed while the app was closed.',
    image: 'scheduled',
    alt: 'The list of scheduled jobs'
  },
  {
    title: 'Reach it from Telegram or Slack',
    text: 'Pair your account with a one time code. Only paired people can talk to your agent, and channel runs start read only.',
    image: 'channels',
    alt: 'Telegram channel setup with pairing steps'
  }
]

const downloads = [
  { key: 'mac-arm64', title: 'macOS', detail: 'Apple Silicon' },
  { key: 'mac-x64', title: 'macOS', detail: 'Intel' },
  { key: 'linux-deb', title: 'Linux', detail: 'Debian and Ubuntu (.deb)' },
  { key: 'linux-appimage', title: 'Linux', detail: 'AppImage' }
]

const title = `Gramatrix - ${TAGLINE}`
const pageUrl = new URL('/', Astro.site).href
const socialImage = new URL('/og.png', Astro.site).href
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={DESCRIPTION} />
    <meta name="theme-color" content="#000000" />
    <link rel="canonical" href={pageUrl} />
    <link rel="sitemap" href="/sitemap.xml" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={DESCRIPTION} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={pageUrl} />
    <meta property="og:site_name" content="Gramatrix" />
    <meta property="og:image" content={socialImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={DESCRIPTION} />
    <meta name="twitter:image" content={socialImage} />
    <link rel="icon" href="/favicon.ico" sizes="48x48" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="icon" href="/icon.png" type="image/png" sizes="512x512" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
  </head>
  <body>
    <a class="skip" href="#main">Skip to content</a>
    <header class="nav">
      <a class="brand" href="/" aria-label="Gramatrix home">
        <img src="/logo.svg" alt="" width="22" height="22" />
        gramatrix
      </a>
      <nav aria-label="Main">
        <a href="#features">Features</a>
        <a href="/docs/">Docs</a>
        <a href={REPOSITORY_URL}>GitHub</a>
      </nav>
      <a class="button small" href="#download">Download</a>
    </header>

    <main id="main">
      <section class="hero">
        <canvas class="ascii" data-ascii aria-hidden="true"></canvas>
        <div class="hero-copy">
          <h1>A coding agent for your desktop.</h1>
          <p class="lead">
            Gramatrix reads your code, edits files and runs commands, and it asks first. Bring your
            own API key or coding plan. No account needed.
          </p>
          <div class="cta">
            <a class="button primary" href="#download" data-primary-download>
              <span data-label>Download</span>
            </a>
            <a class="button" href={REPOSITORY_URL}>GitHub</a>
          </div>
          <p class="note">Free and open source. macOS and Linux.</p>
        </div>
      </section>

      <section class="showcase">
        <img
          class="shot"
          src="/screens/home.webp"
          width="1280"
          height="800"
          alt="Gramatrix open on its home screen"
        />
      </section>

      <section class="providers" aria-label="Supported providers">
        <ul>
          {
            PROVIDERS.map(({ name, logo }) => (
              <li>
                <img src={`/providers/${logo}.svg`} alt="" width="22" height="22" loading="lazy" />
                {name}
              </li>
            ))
          }
        </ul>
      </section>

      <section class="section" id="features">
        {
          rows.map(({ title, text, image, alt }) => (
            <article class="row">
              <div>
                <h2>{title}</h2>
                <p>{text}</p>
              </div>
              <img
                class="shot"
                src={`/screens/${image}.webp`}
                width="1280"
                height="800"
                alt={alt}
                loading="lazy"
              />
            </article>
          ))
        }
      </section>

      <section class="section download" id="download">
        <h2>Download</h2>
        <p class="status" data-release-status>Choose your system.</p>
        <div class="downloads">
          {
            downloads.map(({ key, title, detail }) => (
              <a class="download-card" href={RELEASES_URL} data-card={key}>
                <span class="recommended">Your system</span>
                <h3>{title}</h3>
                <p>{detail}</p>
                <small data-size />
              </a>
            ))
          }
        </div>
        <p class="fine">
          Mac builds are not signed yet, so macOS warns on first launch. Windows is not supported
          yet. Want to contribute? <a href="/docs/contributing/">Start here</a>.
        </p>
      </section>
    </main>

    <div class="wordmark" aria-hidden="true"><canvas data-wordmark></canvas></div>

    <footer class="footer">
      <a class="brand" href="/"><img src="/logo.svg" alt="" width="18" height="18" /> gramatrix</a>
      <nav aria-label="Footer">
        <a href="/docs/">Docs</a>
        <a href={REPOSITORY_URL}>GitHub</a>
        <a href={`${REPOSITORY_URL}/issues`}>Issues</a>
        <a href={`${REPOSITORY_URL}/blob/main/LICENSE`}>MIT license</a>
      </nav>
      <p>Provider names and logos belong to their owners.</p>
    </footer>

    <script>
      import { startAsciiField, startAsciiWordmark } from '../scripts/ascii-field'
      import { connectDownloads } from '../scripts/downloads'

      const canvas = document.querySelector<HTMLCanvasElement>('[data-ascii]')
      if (canvas) startAsciiField(canvas)
      const wordmark = document.querySelector<HTMLCanvasElement>('[data-wordmark]')
      if (wordmark) startAsciiWordmark(wordmark, 'GRAMATRIX')
      void connectDownloads()
    </script>
  </body>
</html>
