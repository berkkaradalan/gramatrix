{
  "name": "gramatrix",
  "version": "0.1.0",
  "private": true,
  "description": "Desktop AI coding agent for macOS and Linux with bring-your-own-key providers.",
  "author": "Gramatrix Contributors",
  "license": "MIT",
  "homepage": "https://github.com/berkkaradalan/gramatrix#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/berkkaradalan/gramatrix.git"
  },
  "bugs": {
    "url": "https://github.com/berkkaradalan/gramatrix/issues"
  },
  "type": "module",
  "main": "out/main/index.js",
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "@ai-sdk/anthropic": "^4.0.92",
    "@ai-sdk/openai": "^4.0.105",
    "@ai-sdk/openai-compatible": "^3.0.81",
    "@chat-adapter/slack": "^4.43.0",
    "@chat-adapter/state-memory": "^4.43.0",
    "@chat-adapter/telegram": "^4.43.0",
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource-variable/jetbrains-mono": "^5.3.0",
    "@openrouter/ai-sdk-provider": "^3.1.0",
    "@radix-ui/react-dialog": "^1.3.1",
    "@radix-ui/react-dropdown-menu": "^2.2.1",
    "@radix-ui/react-popover": "^1.3.1",
    "@radix-ui/react-select": "^2.4.1",
    "@radix-ui/react-switch": "^1.4.1",
    "@radix-ui/react-tabs": "^1.2.1",
    "@radix-ui/react-tooltip": "^1.4.1",
    "@shikijs/engine-javascript": "^4.5.0",
    "@shikijs/langs": "^4.5.0",
    "@shikijs/themes": "^4.5.0",
    "ai": "^7.0.157",
    "chat": "^4.43.0",
    "cmdk": "^1.1.1",
    "croner": "^11.0.0",
    "lucide-react": "^1.65.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "shiki": "^4.5.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "electron": "^45.1.0",
    "electron-builder": "^26.18.0",
    "electron-vite": "^6.0.0",
    "eslint": "^10.13.0",
    "playwright": "^1.64.1",
    "prettier": "^3.9.10",
    "typescript": "^7.0.2",
    "typescript-eslint": "^8.72.1",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  },
  "scripts": {
    "dev": "node scripts/electron-vite.mjs dev",
    "build": "electron-vite build",
    "preview": "node scripts/electron-vite.mjs preview",
    "typecheck": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.web.json",
    "lint": "eslint .",
    "format": "prettier --write .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "npm run build && playwright test",
    "check:ascii": "node scripts/check-ascii.mjs",
    "check": "npm run check:ascii && npm run typecheck && npm run lint && npm run test",
    "dist:mac": "npm run build && electron-builder --mac",
    "dist:linux": "npm run build && electron-builder --linux",
    "update:models": "node scripts/update-model-snapshot.mjs"
  }
}
