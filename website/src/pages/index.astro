---
import '@fontsource-variable/inter'
import '@fontsource-variable/jetbrains-mono'
import '../styles/site.css'
import Icon from '../components/Icon.astro'
import {
  DESCRIPTION,
  MAC_INSTALL_COMMAND,
  PROVIDERS,
  RELEASES_URL,
  REPOSITORY_URL,
  TAGLINE
} from '../data/site'

const features = [
  {
    tab: 'Approvals',
    title: 'Review every change before it happens',
    text: 'Edits show a diff and commands wait for your answer. Each chat has its own mode: read only, ask first, accept edits or full access. Subagents follow the same rules.',
    image: 'chat',
    alt: 'A chat where the agent asks for approval before editing a file'
  },
  {
    tab: 'Models',
    title: 'Use any model you already pay for',
    text: 'Model lists come live from each provider, with context size and price. Connect a pay per token key or a coding plan from Z.ai, MiniMax, Kimi or Alibaba.',
    image: 'models',
    alt: 'The model picker with search, favorites and prices'
  },
  {
    tab: 'Schedules',
    title: 'Run prompts on a schedule',
    text: 'Set a daily review or a weekly report. Every run keeps its transcript, and you choose what happens to runs missed while the app was closed.',
    image: 'scheduled',
    alt: 'The list of scheduled jobs'
  },
  {
    tab: 'Channels',
    title: 'Reach it from Telegram or Slack',
    text: 'Pair your account with a one time code. Only paired people can talk to your agent, and channel runs start read only.',
    image: 'channels',
    alt: 'Telegram channel setup with pairing steps'
  }
]

const linuxBuilds = [
  { key: 'linux-deb', label: 'Debian and Ubuntu (.deb)' },
  { key: 'linux-appimage', label: 'AppImage' }
]

const title = `Gramatrix - ${TAGLINE}`
const pageUrl = new URL('/', Astro.site).href
const socialImage = new URL('/og.png', Astro.site).href
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={DESCRIPTION} />
    <meta name="theme-color" content="#000000" />
    <link rel="canonical" href={pageUrl} />
    <link rel="sitemap" href="/sitemap.xml" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={DESCRIPTION} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={pageUrl} />
    <meta property="og:site_name" content="Gramatrix" />
    <meta property="og:image" content={socialImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={DESCRIPTION} />
    <meta name="twitter:image" content={socialImage} />
    <link rel="icon" href="/favicon.ico" sizes="48x48" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="icon" href="/icon.png" type="image/png" sizes="512x512" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
  </head>
  <body>
    <a class="skip" href="#main">Skip to content</a>
    <header class="nav">
      <a class="brand" href="/" aria-label="Gramatrix home">
        <img src="/logo.svg" alt="" width="22" height="22" />
        gramatrix
      </a>
      <nav aria-label="Main">
        <a href="#features">Features</a>
        <a href="/docs/">Docs</a>
        <a href={REPOSITORY_URL} aria-label="GitHub"><Icon name="github" size={18} /></a>
      </nav>
      <a class="button small" href="#download">Download</a>
    </header>

    <main id="main">
      <section class="hero">
        <canvas class="ascii" data-ascii aria-hidden="true"></canvas>
        <div class="hero-copy">
          <h1>A coding agent for your desktop.</h1>
          <p class="lead">
            Gramatrix reads your code, edits files and runs commands, and it asks first. Bring your
            own API key or coding plan. No account needed.
          </p>
          <div class="cta">
            <a class="button primary" href="#download" data-primary-download>
              <Icon name="download" />
              <span data-label>Download</span>
            </a>
            <a class="button" href={REPOSITORY_URL}><Icon name="github" /> GitHub</a>
          </div>
          <p class="note">Free and open source. macOS and Linux.</p>
        </div>
      </section>

      <section class="tour" id="features" aria-label="Features" data-tour>
        <div class="tour-stage">
          {
            features.map(({ title, text, image, alt }, index) => (
              <article
                class="tour-panel"
                role="tabpanel"
                id={`tour-panel-${index}`}
                aria-labelledby={`tour-tab-${index}`}
                data-active={index === 0 ? 'true' : 'false'}
              >
                <img
                  src={`/screens/${image}.webp`}
                  width="1280"
                  height="800"
                  alt={alt}
                  loading={index === 0 ? 'eager' : 'lazy'}
                />
                <div class="tour-copy">
                  <h2>{title}</h2>
                  <p>{text}</p>
                </div>
              </article>
            ))
          }
        </div>
        <div class="tour-tabs" role="tablist" aria-label="Features">
          {
            features.map(({ tab }, index) => (
              <button
                class="tour-tab"
                type="button"
                role="tab"
                id={`tour-tab-${index}`}
                aria-label={tab}
                aria-controls={`tour-panel-${index}`}
                aria-selected={index === 0 ? 'true' : 'false'}
                tabindex={index === 0 ? 0 : -1}
              />
            ))
          }
        </div>
      </section>

      <section class="providers" aria-label="Supported providers">
        <ul>
          {
            PROVIDERS.map(({ name, logo }) => (
              <li>
                <img src={`/providers/${logo}.svg`} alt="" width="22" height="22" loading="lazy" />
                {name}
              </li>
            ))
          }
        </ul>
      </section>

      <section class="section download" id="download">
        <h2>Download</h2>
        <p class="status" data-release-status>Choose your system.</p>
        <div class="downloads">
          <div data-mac-install>
            <h3>macOS <span class="recommended">Your system</span></h3>
            <div class="install-command">
              <code>{MAC_INSTALL_COMMAND}</code>
              <button type="button" data-copy={MAC_INSTALL_COMMAND}>Copy</button>
            </div>
            <p class="install-note">
              Paste this into Terminal once. Gramatrix goes into your Applications folder and opens
              from Launchpad, Spotlight or the Dock like any other app.
            </p>
          </div>
          <div>
            <h3>Linux</h3>
            <ul>
              {
                linuxBuilds.map(({ key, label }) => (
                  <li>
                    <a class="download-row" href={RELEASES_URL} data-card={key}>
                      {label}
                      <span class="recommended">Your system</span>
                      <small data-size />
                      <Icon name="download" />
                    </a>
                  </li>
                ))
              }
            </ul>
          </div>
        </div>
        <p class="fine">
          The Mac app is not signed by Apple yet, which is why it installs from Terminal. Windows is
          not supported yet. Want to contribute? <a href="/docs/contributing/">Start here</a>.
        </p>
      </section>
    </main>

    <div class="wordmark" aria-hidden="true"><canvas data-wordmark></canvas></div>

    <footer class="footer">
      <a class="brand" href="/"><img src="/logo.svg" alt="" width="18" height="18" /> gramatrix</a>
      <nav aria-label="Footer">
        <a href="/docs/">Docs</a>
        <a href={REPOSITORY_URL}>GitHub</a>
        <a href={`${REPOSITORY_URL}/issues`}>Issues</a>
        <a href={`${REPOSITORY_URL}/blob/main/LICENSE`}>MIT license</a>
      </nav>
      <p>Provider names and logos belong to their owners.</p>
    </footer>

    <script>
      import { startAsciiField, startAsciiWordmark } from '../scripts/ascii-field'
      import { connectCopyButtons, connectDownloads } from '../scripts/downloads'
      import { startFeatureTour } from '../scripts/feature-tour'

      const tour = document.querySelector<HTMLElement>('[data-tour]')
      if (tour) startFeatureTour(tour)
      const canvas = document.querySelector<HTMLCanvasElement>('[data-ascii]')
      if (canvas) startAsciiField(canvas)
      const wordmark = document.querySelector<HTMLCanvasElement>('[data-wordmark]')
      if (wordmark) startAsciiWordmark(wordmark, 'GRAMATRIX')
      void connectDownloads()
      connectCopyButtons()
    </script>
  </body>
</html>
